# Copy this file to ".env" and fill in your own values. ".env" is ignored by Git.
# The defaults below are for local development only.

DATABASE_URL=jdbc:postgresql://localhost:5432/nexus
DATABASE_USER=nexus
DATABASE_PASSWORD=nexus_dev_password

# Secret used to sign login tokens: at least 32 random characters.
JWT_SECRET=local-development-secret-change-me-0123456789

# First owner account, created at the first start when no user exists yet.
NEXUS_OWNER_USERNAME=owner
NEXUS_OWNER_PASSWORD=change-me-please
